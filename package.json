{
  "name": "dev-das-promos",
  "version": "2.0.0",
  "private": true,
  "description": "Finds Amazon/Shopee deals, writes a fun AI post, asks for approval on Telegram, then publishes to Telegram, WhatsApp and X with tracked links.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "collect": "node --env-file-if-exists=.env src/jobs/collect.ts",
    "collect:dry": "node --env-file-if-exists=.env src/jobs/collect.ts --dry-run",
    "migrate": "node --env-file-if-exists=.env src/jobs/migrate.ts",
    "set-webhook": "node --env-file-if-exists=.env src/jobs/set-webhook.ts",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "ai:check": "node --env-file-if-exists=.env src/jobs/ai-check.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.0",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.0.0"
  }
}
