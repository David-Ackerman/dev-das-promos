{
  "name": "dev-das-promos",
  "private": true,
  "version": "0.1.0",
  "description": "Data-driven affiliate deals platform (Amazon BR / Shopee BR)",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @dev-das-promos/database db:generate",
    "db:migrate": "pnpm --filter @dev-das-promos/database db:migrate",
    "db:seed": "pnpm --filter @dev-das-promos/database db:seed",
    "db:studio": "pnpm --filter @dev-das-promos/database db:studio"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
