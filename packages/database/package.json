{
  "name": "@dev-das-promos/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "dotenv -e ../../.env -- vitest run",
    "db:generate": "dotenv -e ../../.env -- tsx ./node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "dotenv -e ../../.env -- tsx src/migrate.ts",
    "db:seed": "dotenv -e ../../.env -- tsx src/seed/index.ts",
    "db:bootstrap-admin": "dotenv -e ../../.env -- tsx src/bootstrap-admin.ts",
    "db:studio": "dotenv -e ../../.env -- tsx ./node_modules/drizzle-kit/bin.cjs studio"
  },
  "dependencies": {
    "@dev-das-promos/config": "workspace:*",
    "@dev-das-promos/shared": "workspace:*",
    "drizzle-orm": "^0.38.2",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@dev-das-promos/affiliate": "workspace:*",
    "@dev-das-promos/content-engine": "workspace:*",
    "@dev-das-promos/deal-engine": "workspace:*",
    "@dev-das-promos/providers": "workspace:*",
    "drizzle-kit": "^0.30.1",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
