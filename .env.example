# Copy to .env for local runs (`npm run collect:dry`, `npm run migrate`).
# In production, put the same names in GitHub:
#   Settings > Secrets and variables > Actions
#   - Secrets: anything marked [secret]
#   - Variables: everything else
# The deploy workflow copies what the Cloudflare Worker needs automatically.

# ---------- Required ----------
# [secret] Neon Postgres connection string (neon.tech > your project > Connect).
DATABASE_URL=postgres://user:password@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Your Worker URL. The first deploy prints it; then add it as a Variable.
PUBLIC_BASE_URL=https://das-promos.YOUR-SUBDOMAIN.workers.dev

# [secret] Token from @BotFather.
TELEGRAM_BOT_TOKEN=
# Where previews go: your private chat with the bot (send /id to the bot to see it).
TELEGRAM_ADMIN_CHAT_ID=
# Optional: who may tap Approve (comma-separated user ids). Default: the admin chat id.
TELEGRAM_ADMIN_USER_IDS=
# [secret] Any random 32+ letters/numbers. Protects the webhook. e.g. `openssl rand -hex 24`
TELEGRAM_WEBHOOK_SECRET=
# Groups/channels that receive approved posts (bot must be admin there). Use /id inside the group.
TELEGRAM_GROUP_IDS=

# [secret] Cloudflare (deploy only): dash.cloudflare.com > My Profile > API Tokens >
# "Edit Cloudflare Workers" template. Account id is on the Workers overview page.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# ---------- Marketplaces (configure at least one) ----------
# Shopee Affiliate Open API: affiliate.shopee.com.br > Open API.
SHOPEE_APP_ID=
# [secret]
SHOPEE_APP_SECRET=
# Comma-separated searches; each run looks at the top results of each.
SHOPEE_KEYWORDS=fone bluetooth,air fryer,smartwatch,cafeteira,mouse gamer
# 2 = best sellers first, 5 = highest commission first, 1 = relevance.
SHOPEE_SORT_TYPE=2

# Amazon Creators API (replaced PA-API in 2026): affiliate-program.amazon.com/creatorsapi
AMAZON_CLIENT_ID=
# [secret]
AMAZON_CLIENT_SECRET=
# Your Associates tag, e.g. meusite-20
AMAZON_PARTNER_TAG=
AMAZON_KEYWORDS=fone bluetooth,air fryer,smartwatch,cafeteira,mouse gamer
# Only change if Amazon's docs give your account a different token URL.
AMAZON_TOKEN_URL=

# Amazon without the API: read public Amazon search pages and post the best discounts
# with your link (amazon.com.br/dp/<ASIN>?tag=AMAZON_PARTNER_TAG).
# ⚠️ OFF by default on purpose: automated reading of Amazon pages goes against the
# Associates agreement; if Amazon notices it can close the account and withhold
# commissions. Amazon also often answers GitHub's servers with a captcha (that run
# then just reports "Amazon bloqueou a busca"). Turn on at your own risk: on
AMAZON_SCRAPE=off
# Search terms (default: AMAZON_KEYWORDS). Keep it short: one request per term.
AMAZON_SCRAPE_QUERIES=
# Result pages per term (1-3) and base pause between requests (ms, randomised up to 2x).
AMAZON_SCRAPE_MAX_PAGES=1
AMAZON_SCRAPE_DELAY_MS=2000

# ---------- AI text (optional; without it a simple line with the product name is used) ----------
# The AI writes one short line about what the product does for you, e.g.
# "Nike Air Max pra você pisar fofo", "Esse teclado vai melhorar sua gameplay".
# Any OpenAI-compatible API. Default is OpenRouter (free models end in ":free",
# see openrouter.ai/models?max_price=0 -- the free list changes over time, and some
# free models refuse plain API use; the bot tells you in Telegram when the AI fails).
AI_BASE_URL=https://openrouter.ai/api/v1
# [secret]
AI_API_KEY=
# Several models separated by commas, tried in order. Free models are often busy, so list a few.
# Check which ones work right now with: npm run ai:check -- --rounds 0
# Prefixes send a model to another provider with its own free quota (and its own key below):
#   groq:<model>  gemini:<model>  cerebras:<model>  openrouter:<model>
AI_MODEL=groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash-lite,groq:qwen/qwen3.8-27b,gemini:gemini-flash-latest,groq:openai/gpt-oss-20b,nvidia/nemotron-3-super-120b-a12b:free,poolside/laguna-xs-2.1:free
# [secret] Free tiers, one quota per provider: console.groq.com, aistudio.google.com (Get API key)
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# ---------- Product photos (optional, costs a few cents per image) ----------
# Store photos on a plain white background (every Amazon main photo) or covered in
# text get replaced by an AI image of the SAME product in the place it's used
# (kitchen, desk, gamer setup…). Done when the preview is made; 🖼️ Nova imagem on a
# preview makes another one, ↩️ Foto da loja goes back. Empty = always the store photo.
#   gemini:<model>      Google AI Studio key in GEMINI_API_KEY, with billing on (image models
#                       have no free tier; e.g. gemini-3.1-flash-lite-image ≈ US$0.034/image)
#   openrouter:<model>  OPENROUTER_API_KEY, e.g. openrouter:google/gemini-2.5-flash-image
IMAGE_MODEL=
# Vision model that looks at the store photo (white background? too much text?).
# Default: gemini:gemini-flash-latest when GEMINI_API_KEY is set (free tier), else the first AI_MODEL.
IMAGE_CHECK_MODEL=
# At most this many AI images a day.
IMAGE_DAILY_LIMIT=20

# ---------- WhatsApp ----------
# share     = after approving, tap a button that opens WhatsApp with the post ready (free, safe)
# evolution = send automatically through your Evolution API server (unofficial)
# zapi      = send automatically through Z-API (paid, unofficial)
# off
WHATSAPP_MODE=share
# Group ids for evolution/zapi, in the format your gateway's docs show (comma-separated).
WHATSAPP_GROUP_IDS=
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# ---------- X / Twitter (pay-per-use API) ----------
# share   = after approving, tap a button that opens X with the post ready (free, you post it)
# no-link = post automatically, text + "link na bio" (paid API, cheaper per post)
# link    = post automatically with the link (paid API, much pricier per post)
# thread  = post WITHOUT link + product photo, then a reply with the link (X shows link-free posts to
#           more people). Limited by X_DAILY_POSTS and X_MONTHLY_BUDGET_USD (see below).
# off
X_MODE=share
# API keys (OAuth 1.0a, "Read and write"): only for no-link / link / thread.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_NO_LINK_TEXT=🔗 Link na bio
# thread mode: at most this many X posts a day; each store's first deal of the day gets a slot,
# extra slots go to Amazon / Mercado Livre, and to Shopee only for these niche words.
X_DAILY_POSTS=3
X_SHOPEE_EXTRA_WORDS=placa de vídeo,placa-mãe,processador,memória ram,ssd nvme,fonte de alimentação,water cooler
# Hard cap per month (spread evenly per day). The link reply is added while today's share allows it.
X_MONTHLY_BUDGET_USD=10
# X's pay-per-use prices per request; update if X changes them.
X_POST_COST_USD=0.015
X_LINK_POST_COST_USD=0.20

# ---------- Tuning ----------
# Your group's niche, in a few words, for the public page's description.
# (The post texts talk about each product, not the audience.) e.g. tecnologia e gadgets
NICHE=
# Offers whose title has any of these words are skipped (whole words, accents ignored).
# e.g. capinha,película,adesivo,réplica,usado,recondicionado
BLOCKED_WORDS=
# Skip offers that were cheaper at some point in the last 30 days (fake "discounts"). true | false
SKIP_FAKE_DISCOUNTS=true
# Publishing queue: approved posts go out one at a time, this many minutes apart,
# only inside POSTING_HOURS (Brasília time, start-end). 0 = publish as soon as approved.
QUEUE_INTERVAL_MINUTES=40
POSTING_HOURS=6-23
# Approve previews automatically when the discount is at least this (with AI text and
# no fake discount); they go to the queue and you can still unschedule them. 0 = off.
AUTO_APPROVE_MIN_DISCOUNT=0
POSTS_PER_RUN=2
MIN_DISCOUNT_PCT=20
# Don't suggest the same product again for this many days.
REPOST_COOLDOWN_DAYS=14
# Previews not answered in this many hours expire.
PENDING_TTL_HOURS=12
POST_FOOTER=#publi · link de afiliado

# ---------- Public deals page (the Worker's main address) ----------
SITE_NAME=Dev das Promos
# Buttons at the top of the page (optional, https only): group invite links and your X profile.
SITE_TELEGRAM_URL=
SITE_WHATSAPP_URL=
SITE_X_URL=https://x.com/devdaspromocoes

# ---------- Starting the deal search (schedule + /buscar) ----------
# The Worker's cron (wrangler.toml) and /buscar start the Collect workflow with this.
# [secret] Fine-grained GitHub token, only this repo, "Actions: Read and write".
GH_DISPATCH_TOKEN=
GH_REPO=David-Ackerman/dev-das-promos
# Only if you renamed the workflow file or deploy from another branch.
GH_COLLECT_WORKFLOW=collect.yml
GH_REF=main
