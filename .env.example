# --- Core infrastructure ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/das_promos
REDIS_URL=redis://localhost:6379
# Production Compose requires a fresh 32-byte hex secret; API startup also
# rejects a PostgreSQL DATABASE_URL password shorter than 32 characters.
POSTGRES_PASSWORD=
# DNS name pointing to the VM for automatic HTTPS via Caddy.
API_HOST=

# --- Services ---
API_PORT=4000
API_URL=http://localhost:4000
ADMIN_URL=http://localhost:3001
PUBLIC_WEB_URL=http://localhost:3000

# Browser-visible copies for the Next.js apps (Next only inlines NEXT_PUBLIC_*
# vars into client bundles -- server components use API_URL above directly).
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Required in production so visitors can identify the operator and contact it.
PUBLIC_OPERATOR_NAME=
PUBLIC_CONTACT_EMAIL=

# --- Internal service-to-service auth (n8n, admin -> api) ---
# Development only. Production requires a rotated value with at least 32 characters.
INTERNAL_API_TOKEN=dev-internal-token-change-me

# --- Admin session auth ---
# Development only. Production requires a rotated secret with at least 32 characters.
AUTH_SECRET=dev-auth-secret-change-me-please-32chars
# Set to the shared parent domain in production (e.g. .example.com)
# when admin.example.com and api.example.com are separate hosts.
SESSION_COOKIE_DOMAIN=
ADMIN_EMAIL=admin@example.com
# Development only. Production requires a real email and a rotated password with at least 12 characters.
ADMIN_PASSWORD=change-me-please

# --- Marketplace affiliate credentials (optional in dev, mocks are used when absent) ---
# Required with AMAZON_CREATORS_CLIENT_ID/SECRET for real Amazon requests.
AMAZON_AFFILIATE_TAG=
# Optional development/mock fallback only; real Shopee Open API links use App ID/Secret.
SHOPEE_AFFILIATE_ID=
MERCADO_LIVRE_AFFILIATE_ID=

# --- Amazon Creators API (optional, mock provider used when absent). Replaces
# the retired PA-API 5.0 -- register separately at
# https://affiliate-program.amazon.com/creatorsapi to get these, old PA-API
# access/secret keys do NOT work here. ---
AMAZON_CREATORS_CLIENT_ID=
AMAZON_CREATORS_CLIENT_SECRET=

# --- Shopee Affiliate Open API (optional, mock provider used when absent) ---
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# --- Mercado Livre API -- OAuth2 app credentials + a refresh token obtained
# once via a manual authorization-code exchange (optional, mock provider
# used when absent; see docs/providers.md) ---
MERCADO_LIVRE_APP_ID=
MERCADO_LIVRE_CLIENT_SECRET=
MERCADO_LIVRE_REFRESH_TOKEN=

# --- Telegram publisher (optional in dev, mock publisher is used when absent) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- X/Twitter publisher (optional in dev, mock publisher is used when absent) ---
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- AI content generation via OpenRouter (optional, deterministic
# templates are used when absent or when the daily quota below is spent).
# Get a key at https://openrouter.ai/keys. OPENROUTER_MODEL must be a
# currently-free model slug (ends in ":free") -- check
# https://openrouter.ai/models?max_price=0 for the current list, e.g.
# "z-ai/glm-5.2:free" as of 2026-09; this rotates over time so verify
# before setting it. ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Caps AI-generated posts per UTC day, comfortably under OpenRouter's free-tier
# request cap (50/day on a fresh account, 1000/day after any credit purchase).
AI_CONTENT_DAILY_LIMIT=10

# Raw click-event retention window; old per-click records (including hashed IPs)
# are deleted daily. Confirm this window against the operator's privacy policy.
CLICK_EVENT_RETENTION_DAYS=180

# --- Self-scheduled ingestion + publish routine (apps/api/src/lib/scheduler.ts).
# Off by default -- turn on only once you're ready for the app to actually
# post to real Telegram/X channels on its own. Adjusting the times/
# marketplaces needs an env change + restart, there's no UI for it (an
# n8n-driven schedule is the upgrade path if you want that later, see
# docs/deployment.md). ---
SCHEDULE_ENABLED=false
# Comma-separated 24h UTC "HH:mm" times to run the routine.
SCHEDULE_TIMES=09:00,13:00,17:00,21:00
# Comma-separated marketplaces to ingest/publish each cycle. Only Amazon
# and Shopee are supported; Mercado Livre affiliate URLs require manual setup.
SCHEDULE_MARKETPLACES=shopee_br
# Minutes after each ingest time before publishing, so evaluation finishes first.
SCHEDULE_PUBLISH_DELAY_MINUTES=15
# Max deals published per scheduled run.
SCHEDULE_PUBLISH_LIMIT=1

NODE_ENV=development
# Demo seed refuses NODE_ENV=production and remote DB hosts unless this is explicitly true.
ALLOW_DEMO_SEED=false
